{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pages-emdash",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-02-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "hashitaku.dev",
      "custom_domain": true,
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pages-emdash-data",
      "migrations_dir": "../../migrations",
      "database_id": "44ca8ef8-3db9-40a7-8ea4-5dc862cfa8de",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "pages-emdash-media",
    },
  ],
  "worker_loaders": [
    {
      "binding": "LOADER",
    },
  ],
  "triggers": {
    "crons": ["* * * * *"],
  },
  "observability": {
    "enabled": true,
  },
}
